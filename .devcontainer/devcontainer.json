{
    "name": "C++ Microservice Dev",
    "build": {
        "context": "../endless",
        "dockerfile": "../endless/Dockerfile",
        "target": "build" 
    },
    "runArgs": [
        "--name", "endless-microservice-dev"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack"
            ]
        }
    },
    "remoteUser": "root"
}