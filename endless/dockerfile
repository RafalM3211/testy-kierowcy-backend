# Use the official Ubuntu image as the base image
FROM ubuntu:22.04 AS build

# Set the working directory in the container
WORKDIR /app

# Install necessary dependencies
RUN apt-get update && apt-get install -y \
    g++ \
    libcpprest-dev \
    libboost-all-dev \
    libssl-dev \
    libspdlog-dev \
    libfmt-dev \
    cmake

# Copy the source code into the container
COPY *.cpp *.hpp ./
COPY ./features/api/*.cpp ./features/api/*.hpp ./features/api/
COPY ./features/logger/*.cpp ./features/logger/*.hpp ./features/logger/
COPY ./features/tokenizer/*.cpp ./features/tokenizer/*.hpp ./features/tokenizer/
COPY ./features/types/*.hpp ./features/types/
COPY ./features/controllers/*.hpp ./features/controllers/
COPY ./features/controllers/*.cpp ./features/controllers/


# Compile the C++ code
RUN g++ -std=c++20 -c ./features/logger/logger.cpp -o ./features/logger.o
RUN g++ -std=c++20 -c ./features/tokenizer/tokenizer.cpp -o ./features/tokenizer.o
RUN g++ -std=c++20 -c ./features/controllers/syncController.cpp -o ./features/syncController.o
RUN g++ -std=c++20 -c ./features/controllers/questionController.cpp -o ./features/questionController.o
RUN g++ -std=c++20 -c ./features/api/api.cpp -o ./features/api.o 
RUN g++ -std=c++20 -o endless endless.cpp \
    ./features/api.o \
    ./features/logger.o \
    ./features/tokenizer.o \
    ./features/syncController.o \
    ./features/questionController.o \
    -lcpprest -lboost_system -lboost_thread -lboost_chrono -lboost_random -lssl -lcrypto -lspdlog -lfmt

FROM ubuntu:22.04
WORKDIR /app
RUN apt-get update && apt-get install -y \
    libcpprest2.10 \
    libboost-system1.74.0 \
    libboost-thread1.74.0 \
    libboost-chrono1.74.0 \
    libboost-random1.74.0 \
    libssl3 \
    libfmt8 \
    libspdlog1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/endless .

# Expose the port on which the API will listen
EXPOSE 8080

# Command to run the API when the container starts
CMD ["./endless"]
